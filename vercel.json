{
  "functions": {
    "api/playa.js": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/playa.html"
    },
    "api/transcribe.js": {
      "maxDuration": 60
    },
    "api/ldn-refresh.mjs": {
      "maxDuration": 300
    },
    "api/tracks-playlist.js": {
      "maxDuration": 30
    },
    "api/tracks-ocr.js": {
      "maxDuration": 60
    },
    "api/londonplan.js": {
      "maxDuration": 10
    },
    "api/dev.js": {
      "maxDuration": 10
    },
    "api/dev-ask.js": {
      "maxDuration": 30
    },
    "api/flights.js": {
      "maxDuration": 25
    }
  },
  "crons": [
    {
      "path": "/api/ldn-refresh",
      "schedule": "0 8 1 * *"
    }
  ],
  "redirects": [
    {
      "source": "/awakening",
      "destination": "https://knomi.club/",
      "permanent": true
    },
    {
      "source": "/awakening/",
      "destination": "https://knomi.club/",
      "permanent": true
    },
    {
      "source": "/awakening/img/:path*",
      "destination": "https://knomi.club/img/:path*",
      "permanent": true
    },
    {
      "source": "/awakening/:path*",
      "destination": "https://knomi.club/:path*",
      "permanent": true
    },
    {
      "source": "/phone",
      "destination": "https://phone-nine-theta.vercel.app",
      "permanent": false
    },
    {
      "source": "/phone/:path*",
      "destination": "https://phone-nine-theta.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/vroom",
      "destination": "https://vroom.fan/",
      "permanent": true
    },
    {
      "source": "/vroom/:path(.*)",
      "destination": "https://vroom.fan/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/playa",
      "destination": "/api/playa"
    },
    {
      "source": "/playa/",
      "destination": "/api/playa"
    },
    {
      "source": "/playa/:path*",
      "destination": "/api/playa"
    },
    {
      "source": "/londonplan",
      "destination": "/api/londonplan"
    },
    {
      "source": "/londonplan/",
      "destination": "/api/londonplan"
    },
    {
      "source": "/dev",
      "destination": "/api/dev"
    },
    {
      "source": "/dev/",
      "destination": "/api/dev"
    },
    {
      "source": "/dev/ask",
      "destination": "/api/dev-ask"
    },
    {
      "source": "/flights",
      "destination": "/flights/index.html"
    },
    {
      "source": "/flights/",
      "destination": "/flights/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "headers": [
    {
      "source": "/flights/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
